{
    "$schema": "https://raw.githubusercontent.com/LiteLoaderQQNT/Plugin-Template/main/manifest_schema.json",
    "manifest_version": 4,
    "type": "extension",
    "name": "合并转发搜索",
    "slug": "forward-search",
    "description": "按内容搜索聊天里的合并转发卡片。输入一句话，直接找回那一整张聊天记录。",
    "version": "1.0.3",
    "icon": "./assets/icon.png",
    "thumb": "./assets/thumb.png",
    "authors": [
        {
            "name": "fushengzhenjun",
            "link": "https://github.com/fushengzhenjun"
        }
    ],
    "dependencies": [],
    "platform": [
        "win32",
        "linux",
        "darwin"
    ],
    "injects": {
        "main": "./src/main.js",
        "preload": "./src/preload.js",
        "renderer": "./src/renderer.js"
    },
    "repository": {
        "repo": "fushengzhenjun/LiteLoaderQQNT-Plugin-ForwardSearch",
        "branch": "main",
        "release": {
            "tag": "1.0.0",
            "file": "forward-search.zip"
        }
    }
}
